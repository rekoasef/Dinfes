# Supabase (Project Settings → API). The publishable key is safe in the browser:
# Row Level Security decides what each visitor can read or write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared secret for /api/keepalive. Vercel Cron sends it automatically.
CRON_SECRET=

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
